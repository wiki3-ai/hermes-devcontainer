{
  "name": "Hermes Agent + Unsloth",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "overrideCommand": false,
  "containerEnv": {
    "HERMES_DASHBOARD": "1",
    "HERMES_DASHBOARD_HOST": "0.0.0.0",
    "HERMES_DASHBOARD_BASIC_AUTH_USERNAME": "hermes",
    "HERMES_DASHBOARD_BASIC_AUTH_PASSWORD": "hermes-devcontainer",
    "HERMES_DASHBOARD_BASIC_AUTH_SECRET": "hermes-devcontainer-basic-auth-secret-change-me",
    "API_SERVER_ENABLED": "true",
    "API_SERVER_HOST": "0.0.0.0",
    "API_SERVER_KEY": "hermes-devcontainer-local-api-key"
  },
  "mounts": [
    "source=hermes-opt-data,target=/opt/data,type=volume"
  ],
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--add-host=host.containers.internal:host-gateway"
  ],
  "postCreateCommand": ".devcontainer/configure-hermes.sh",
  "forwardPorts": [
    8642,
    9119
  ],
  "portsAttributes": {
    "8642": {
      "label": "Hermes Gateway API",
      "onAutoForward": "notify",
      "protocol": "http",
      "visibility": "public"
    },
    "9119": {
      "label": "Hermes Dashboard",
      "onAutoForward": "openPreview",
      "protocol": "http",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}